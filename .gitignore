# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local embedded postgres data
/.pgdata/

# Claude Code worktrees — throwaway local checkouts, never source.
# Scoped to worktrees ONLY: .claude/skills/ is deliberately committed
# (the Prisma skill set), so a blanket .claude/ rule would be wrong.
/.claude/worktrees/
